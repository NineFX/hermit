//// Generates the Erlang module that loads a NIF library.
////
//// Gleam cannot declare an `-on_load` hook, so every NIF library needs a
//// small Erlang module: it loads the compiled Rust library from the OTP
//// application's `priv` directory and holds a stub for each NIF, which the
//// library replaces as it loads.

import gleam/int
import gleam/list
import gleam/string
import hermit/ir
import hermit/naming

/// The base name, without extension, of the compiled library in `priv`.
/// `erlang:load_nif/2` adds `.so` or `.dll` itself.
pub fn library_file(library: ir.Library) -> String {
  "lib" <> naming.crate_name(library.erlang_module)
}

pub fn loader(library: ir.Library) -> String {
  let exports =
    library.functions
    |> list.map(fn(function) {
      naming.erlang_atom(function.erlang_name)
      <> "/"
      <> int.to_string(list.length(function.parameters))
    })
    |> list.map(fn(export) { "\n    " <> export })
    |> string.join(",")
  let stubs =
    library.functions
    |> list.map(fn(function) {
      let arguments =
        list.repeat("_", list.length(function.parameters)) |> string.join(", ")
      naming.erlang_atom(function.erlang_name)
      <> "("
      <> arguments
      <> ") ->\n    erlang:nif_error(nif_not_loaded).\n"
    })
    |> string.join("\n")
  "%% @generated by hermit from " <> library.source <> ". Do not edit this file:
%% change the Gleam module and run `gleam run -m hermit generate`.
-module(" <> naming.erlang_atom(library.erlang_module) <> ").

-export([" <> exports <> "\n]).
-nifs([" <> exports <> "\n]).
-on_load(init/0).

init() ->
    PrivDir =
        case code:priv_dir(" <> naming.erlang_atom(library.otp_app) <> ") of
            {error, bad_name} ->
                Ebin = filename:dirname(code:which(?MODULE)),
                filename:join(filename:dirname(Ebin), \"priv\");
            Dir ->
                Dir
        end,
    case erlang:load_nif(filename:join(PrivDir, \"" <> library_file(library) <> "\"), 0) of
        ok ->
            ok;
        {error, {_, Text}} = Error ->
            %% The VM only logs this, and `gleam run` can exit before the
            %% log is written, so print it too.
            io:format(standard_error, \"~s: ~ts~n\", [?MODULE, Text]),
            Error
    end.

" <> stubs
}
