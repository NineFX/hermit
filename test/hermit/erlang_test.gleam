import hermit/erlang
import hermit/ir

pub fn loader_test() {
  let library =
    ir.Library(
      erlang_module: "app_nif",
      otp_app: "app",
      source: "src/app/nif.gleam",
      types: [],
      functions: [
        ir.Function(
          "add",
          "Add",
          [ir.Parameter("a", ir.Int), ir.Parameter("b", ir.Int)],
          ir.Int,
          ir.Normal,
        ),
        ir.Function("now", "now", [], ir.Int, ir.DirtyIo),
      ],
    )
  assert erlang.library_file(library) == "libapp_nif"
  assert erlang.loader(library)
    == "%% @generated by hermit from src/app/nif.gleam. Do not edit this file:
%% change the Gleam module and run `gleam run -m hermit generate`.
-module(app_nif).

-export([
    'Add'/2,
    now/0
]).
-nifs([
    'Add'/2,
    now/0
]).
-on_load(init/0).

init() ->
    PrivDir =
        case code:priv_dir(app) of
            {error, bad_name} ->
                Ebin = filename:dirname(code:which(?MODULE)),
                filename:join(filename:dirname(Ebin), \"priv\");
            Dir ->
                Dir
        end,
    %% On Windows, the library's directory is searched for the libraries it
    %% links against only if its path uses backslashes.
    Library = filename:nativename(filename:join(PrivDir, \"libapp_nif\")),
    case erlang:load_nif(Library, 0) of
        ok ->
            ok;
        {error, {_, Text}} = Error ->
            %% The VM only logs this, and `gleam run` can exit before the
            %% log is written, so print it too.
            io:format(standard_error, \"~s: ~ts~n\", [?MODULE, Text]),
            Error
    end.

'Add'(_, _) ->
    erlang:nif_error(nif_not_loaded).

now() ->
    erlang:nif_error(nif_not_loaded).
"
}
